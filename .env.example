# ──────────────────────────────────────────────
# Servidor
# ──────────────────────────────────────────────
NODE_ENV=development
# APP_ENV tem precedência sobre NODE_ENV: development | staging | production
APP_ENV=development
PORT=3000

# ──────────────────────────────────────────────
# Banco de dados (MySQL ou compatível)
# Exemplos:
#   Local Docker : mysql://root:senha@localhost:3306/licigov
#   PlanetScale  : mysql://user:pass@host/licigov?ssl={"rejectUnauthorized":true}
#   TiDB Cloud   : mysql://user:pass@host:4000/licigov?ssl={"rejectUnauthorized":true}
# ──────────────────────────────────────────────
DATABASE_URL=mysql://root:senha@localhost:3306/licigov

# ──────────────────────────────────────────────
# JWT — string aleatória longa (mín. 32 chars)
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ──────────────────────────────────────────────
JWT_SECRET=troque-por-uma-string-aleatoria-longa-aqui

# ──────────────────────────────────────────────
# Sessão e acesso (RC-SEC-PR-A)
# ──────────────────────────────────────────────
# TTL da sessão em horas (1 a 720). Default 24. Produção: manter curto.
SESSION_TTL_HOURS=24
# Registro público (fail-closed). Default false. NUNCA true em produção sem
# provisionamento por convite/vinculação administrativa.
ALLOW_PUBLIC_REGISTRATION=false
# Senha do admin inicial (OBRIGATÓRIA em produção/staging; sem default).
# Mínimo 8 caracteres. Nunca versionar o valor real.
ADMIN_PASSWORD=troque-por-uma-senha-forte
# ADMIN_EMAIL=admin@seu-orgao.gov.br
# ADMIN_NAME=Administrador

# ──────────────────────────────────────────────
# Google Gemini (IA)
# Obter em: https://aistudio.google.com/app/apikey
# ──────────────────────────────────────────────
GEMINI_API_KEY=sua-chave-gemini-aqui
# Provider de IA (opcional): gemini | claude | openai (default gemini)
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ──────────────────────────────────────────────
# AWS S3 (Storage Service) — OBRIGATÓRIO em produção
# ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=
# AWS_S3_BUCKET_STAGING=
# AWS_S3_PUBLIC_URL=

# ──────────────────────────────────────────────
# Variáveis legadas Manus — não são mais usadas
# após a Fase 2 do plano de recuperação.
# Deixe em branco ou remova depois da Fase 2.
# ──────────────────────────────────────────────
# OAUTH_SERVER_URL=
# VITE_APP_ID=
# OWNER_OPEN_ID=
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
